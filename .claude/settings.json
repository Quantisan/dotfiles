{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(git branch:*)",
      "Bash(git status:*)",
      "Bash(gh pr list:*)",
      "Skill(commit)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enableArtifact": false,
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "/opt/homebrew/bin/bb ~/.claude/statusline.clj"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "elements-of-style@superpowers-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "gremllm-handoff@gremllm": true
  },
  "extraKnownMarketplaces": {
    "gremllm": {
      "source": {
        "source": "directory",
        "path": "/Users/paul/Projects/gremllm-plugins"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "askUserQuestionTimeout": "never",
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "preferredNotifChannel": "ghostty",
  "inputNeededNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: github.com/Quantisan and all repos under it"
    ]
  },
  "voiceEnabled": true
}
