#!/usr/bin/env bash

# Create a new directory and enter it
function mkd() {
        mkdir -p "$@" && cd "$_"
}

# Change working directory to the top-most Finder window location
function cdf() { # short for `cdfinder`
        cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')"
}

# Create a .tar.gz archive, using `zopfli`, `pigz` or `gzip` for compression
function targz() {
        local tmpFile="${@%/}.tar"
        tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1

        size=$(
                stat -f"%z" "${tmpFile}" 2>/dev/null # macOS `stat`
                stat -c"%s" "${tmpFile}" 2>/dev/null # GNU `stat`
        )

        local cmd=""
        if ((size < 52428800)) && hash zopfli 2>/dev/null; then
                # the .tar file is smaller than 50 MB and Zopfli is available; use it
                cmd="zopfli"
        else
                if hash pigz 2>/dev/null; then
                        cmd="pigz"
                else
                        cmd="gzip"
                fi
        fi

        echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…"
        "${cmd}" -v "${tmpFile}" || return 1
        [ -f "${tmpFile}" ] && rm "${tmpFile}"

        zippedSize=$(
                stat -f"%z" "${tmpFile}.gz" 2>/dev/null # macOS `stat`
                stat -c"%s" "${tmpFile}.gz" 2>/dev/null # GNU `stat`
        )

        echo "${tmpFile}.gz ($((zippedSize / 1000)) kB) created successfully."
}

# Determine size of a file or total size of a directory
function fs() {
        if du -b /dev/null >/dev/null 2>&1; then
                local arg=-sbh
        else
                local arg=-sh
        fi
        if [[ -n "$@" ]]; then
                du $arg -- "$@"
        else
                du $arg .[^.]* ./*
        fi
}

# Use Git’s colored diff when available
hash git &>/dev/null
if [ $? -eq 0 ]; then
        function diff() {
                git diff --no-index --color-words "$@"
        }
fi

# Create a data URL from a file
function dataurl() {
        local mimeType=$(file -b --mime-type "$1")
        if [[ $mimeType == text/* ]]; then
                mimeType="${mimeType};charset=utf-8"
        fi
        echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')"
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
        local port="${1:-8000}"
        sleep 1 && open "http://localhost:${port}/" &
        # Set the default Content-Type to `text/plain` instead of `application/octet-stream`
        # And serve everything as UTF-8 (although not technically correct, this doesn’t break anything for binary files)
        python -c $'import SimpleHTTPServer;\nmap = SimpleHTTPServer.SimpleHTTPRequestHandler.extensions_map;\nmap[""] = "text/plain";\nfor key, value in map.items():\n\tmap[key] = value + ";charset=UTF-8";\nSimpleHTTPServer.test();' "$port"
}

# Start a PHP server from a directory, optionally specifying the port
# (Requires PHP 5.4.0+.)
function phpserver() {
        local port="${1:-4000}"
        local ip=$(ipconfig getifaddr en1)
        sleep 1 && open "http://${ip}:${port}/" &
        php -S "${ip}:${port}"
}

# Compare original and gzipped file size
function gz() {
        local origsize=$(wc -c <"$1")
        local gzipsize=$(gzip -c "$1" | wc -c)
        local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l)
        printf "orig: %d bytes\n" "$origsize"
        printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio"
}

# Run `dig` and display the most useful info
function digga() {
        dig +nocmd "$1" any +multiline +noall +answer
}

# Show all the names (CNs and SANs) listed in the SSL certificate
# for a given domain
function getcertnames() {
        if [ -z "${1}" ]; then
                echo "ERROR: No domain specified."
                return 1
        fi

        local domain="${1}"
        echo "Testing ${domain}…"
        echo "" # newline

        local tmp=$(echo -e "GET / HTTP/1.0\nEOT" |
                openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1)

        if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
                local certText=$(echo "${tmp}" |
                        openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
      no_serial, no_sigdump, no_signame, no_validity, no_version")
                echo "Common Name:"
                echo "" # newline
                echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//"
                echo "" # newline
                echo "Subject Alternative Name(s):"
                echo "" # newline
                echo "${certText}" | grep -A 1 "Subject Alternative Name:" |
                        sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2
                return 0
        else
                echo "ERROR: Certificate not found."
                return 1
        fi
}

# Normalize `open` across Linux, macOS, and Windows.
# This is needed to make the `o` function (see below) cross-platform.
if [ ! $(uname -s) = 'Darwin' ]; then
        if grep -q Microsoft /proc/version; then
                # Ubuntu on Windows using the Linux subsystem
                alias open='explorer.exe'
        else
                alias open='xdg-open'
        fi
fi

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
        if [ $# -eq 0 ]; then
                open .
        else
                open "$@"
        fi
}

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
        tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX
}

# 'reader' returns LLM-friendly markdown from a URL
function reader() {
        if [ $# -eq 0 ]; then
                echo "Usage: reader <URL>"
                return 1
        fi

        local url="$1"
        curl "https://r.jina.ai/$url"
}

# 'claude-afk' launches an unattended Claude Code session that resumes itself
# when the 5-hour usage window runs out. Run it instead of `claude` for a long
# job you want to walk away from. It runs Claude in a tmux session alongside a
# watcher window that waits for the "hit your session limit" banner, sleeps
# until the stated reset time, then sends `continue`. Closing the terminal does
# not kill the run; re-attach with `tmux attach -t afk-<pid>`.
function claude-afk() {
        # Internal watcher mode, launched in the tmux 'watch' window:
        #   claude-afk __watch <session> <main-window-id>
        if [ "$1" = "__watch" ]; then
                _claude_afk_watch "$2" "$3"
                return
        fi

        if ! command -v tmux >/dev/null 2>&1; then
                echo "claude-afk: needs tmux (brew install tmux)" >&2
                return 1
        fi

        local sess="afk-$$"
        local cmd="claude"
        if [ "$#" -gt 0 ]; then
                cmd="claude $(printf '%q ' "$@")"
        fi

        # Pass the caller's PATH so `claude` resolves even if a tmux server is
        # already running with a minimal environment.
        tmux new-session -d -s "$sess" -n main -e "PATH=$PATH" "$cmd"

        # Identify the claude window by its immutable id, not its name (tmux's
        # automatic-rename can change the name out from under us).
        local main_id
        main_id="$(tmux display-message -p -t "$sess:main" '#{window_id}')"
        tmux new-window -d -t "$sess" -n watch "bash -lc 'claude-afk __watch $sess $main_id'"

        if [ -n "$TMUX" ]; then
                tmux switch-client -t "$sess"
        else
                tmux attach-session -t "$sess"
        fi
}

# Sleep up to the given seconds in 15s chunks, returning early (non-zero) if the
# claude window disappears. Keeps the watcher responsive to claude exiting even
# in the middle of a multi-hour wait for the usage window to reset.
function _claude_afk_nap() {
        local total="$1" session="$2" main="$3" slept=0
        while [ "$slept" -lt "$total" ]; do
                tmux list-windows -t "$session" -F '#{window_id}' 2>/dev/null \
                        | grep -qx "$main" || return 1
                sleep 15
                slept=$((slept + 15))
        done
        return 0
}

# Watcher loop for claude-afk. Polls the claude window; when Claude reports the
# session limit, waits until the reset time it prints, then sends `continue`.
# Logs every action to ~/.claude-afk.log. Tears the session down when claude exits.
function _claude_afk_watch() {
        local session="$1"
        local main="$2"   # the claude window's tmux id, e.g. @3
        local log="$HOME/.claude-afk.log"
        local banner="hit your session limit"

        echo "$(date '+%F %T') claude-afk watching $session ($main)" >> "$log"
        # Loop while the claude window still exists. Guarding on the session
        # would be circular — this watcher's own window keeps the session alive —
        # so we key off the main window's disappearance when claude exits.
        while tmux list-windows -t "$session" -F '#{window_id}' 2>/dev/null | grep -qx "$main"; do
                local screen
                screen="$(tmux capture-pane -p -t "$main" 2>/dev/null)"
                if printf '%s\n' "$screen" | grep -qF "$banner"; then
                        local line secs
                        line="$(printf '%s\n' "$screen" | grep -F "$banner" | tail -1)"
                        secs="$(_claude_afk_wait_secs "$line")"
                        echo "$(date '+%F %T') limit hit; waiting ${secs}s ($line)" >> "$log"
                        _claude_afk_nap "$secs" "$session" "$main" || continue
                        tmux send-keys -t "$main" "continue" Enter
                        echo "$(date '+%F %T') sent 'continue' to $main" >> "$log"
                        # Let the screen redraw, then wait for the banner to clear
                        # (cap ~10 min) so we never re-send on the lingering message.
                        _claude_afk_nap 60 "$session" "$main" || continue
                        local tries=0
                        while [ "$tries" -lt 18 ] && \
                                tmux capture-pane -p -t "$main" 2>/dev/null | grep -qF "$banner"; do
                                sleep 30
                                tries=$((tries + 1))
                        done
                fi
                # Poll every ~3min, but nap in chunks so we notice an exit (and
                # tear down) within ~15s instead of blocking for the full cycle.
                _claude_afk_nap 180 "$session" "$main" || break
        done
        # claude exited -> tear down the whole session so no window lingers.
        echo "$(date '+%F %T') claude window gone; killing session $session" >> "$log"
        tmux kill-session -t "$session" 2>/dev/null
}

# Given the limit banner line (e.g. '... resets 9:40am (Asia/Tokyo)'), print the
# seconds until that wall-clock time next occurs in that timezone, plus a 5min
# buffer. Prints 300 on any parse failure so the watcher still retries safely.
function _claude_afk_wait_secs() {
        python3 - "$1" <<'PY' 2>/dev/null || echo 300
import re, sys, datetime
try:
    from zoneinfo import ZoneInfo
except Exception:
    print(300); raise SystemExit
m = re.search(r'resets\s+(\d{1,2})(?::(\d{2}))?\s*([ap]m)\s*\(([^)]+)\)', sys.argv[1], re.I)
if not m:
    print(300); raise SystemExit
hour = int(m.group(1)) % 12 + (12 if m.group(3).lower() == 'pm' else 0)
minute = int(m.group(2) or 0)
try:
    tz = ZoneInfo(m.group(4).strip())
except Exception:
    print(300); raise SystemExit
now = datetime.datetime.now(tz)
target = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
if target <= now:
    target += datetime.timedelta(days=1)
print(int((target - now).total_seconds()) + 300)
PY
}
